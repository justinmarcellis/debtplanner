# OpenTelemetry export to FinTechCo's collector / SIEM [CLM-656] [CLM-684] [CLM-612]
# Set these in the managed settings env block: Claude Code ignores exporter variables in a repo's .claude/settings.json.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.fintechco.example:4317
# Prompt text stays redacted unless OTEL_LOG_USER_PROMPTS=1 (default off). Tool names from MCP servers are
# redacted unless OTEL_LOG_TOOL_DETAILS=1. Each permission accept/reject emits a claude_code.tool_decision event.
