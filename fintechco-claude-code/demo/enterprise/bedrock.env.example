# Route Claude Code through Amazon Bedrock in FinTechCo's own AWS account [CLM-686] [CLM-688]
# Prerequisites: Anthropic use-case form submitted once per account (or org-wide via PutUseCaseForModelAccess);
# IAM: bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream, bedrock:ListInferenceProfiles, bedrock:GetInferenceProfile.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
AWS_PROFILE=fintechco-claude-code      # SSO profile in a dedicated AWS account for Claude Code
# Pin model versions for multi-user deployments (copy the inference profile IDs from the Bedrock console):
ANTHROPIC_DEFAULT_SONNET_MODEL=<bedrock inference profile id for Claude Sonnet 5.5>
ANTHROPIC_DEFAULT_OPUS_MODEL=<bedrock inference profile id for Claude Opus 5.5>
ANTHROPIC_DEFAULT_HAIKU_MODEL=<bedrock inference profile id for Claude Haiku 5.5>
# Optional: corporate egress proxy or an LLM gateway in front of Bedrock
# HTTPS_PROXY=https://proxy.fintechco.example:8443
