# Route Claude Code through Google Cloud's Agent Platform (formerly Vertex AI) in FinTechCo's GCP project [CLM-687] [CLM-688]
# Prerequisites: aiplatform.googleapis.com enabled; Claude models requested in Model Garden (approval can take 24-48h);
# regional quota allocated; roles/aiplatform.user granted to the engineers' group.
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=us-east5
ANTHROPIC_VERTEX_PROJECT_ID=fintechco-claude-code      # dedicated project for cost tracking and access control
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5
